<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F9FA"
    android:orientation="vertical">

    <!-- ส่วนหัวแอป (Header) สีเขียวเข้มพร้อมโลโก้, ชื่อ, ปุ่มลงประกาศ และไอคอนโปรไฟล์ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#00794C"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="36dp"
        android:paddingBottom="12dp">

        <!-- ไอคอนโลโก้แอป -->
        <ImageView
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_marginRight="10dp"
            android:background="#FFFFFF"
            android:padding="6dp"
            android:src="@drawable/ic_launcher_foreground" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PSRU Swap"
                android:textColor="#FFFFFF"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ตลาดนัดส่งต่อของ ม.ราชภัฏพิบูลสงคราม"
                android:textColor="#D1E7DD"
                android:textSize="10.5sp" />
        </LinearLayout>

        <!-- ปุ่มลงประกาศ -->
        <TextView
            android:id="@+id/btnOpenPost"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:layout_marginRight="10dp"
            android:background="#00A86B"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:paddingHorizontal="12dp"
            android:text="+ ลงประกาศ"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold" />

        <!-- ปุ่มโปรไฟล์ขวาบน -->
        <ImageView
            android:id="@+id/btnHeaderProfile"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="#E9ECEF"
            android:clickable="true"
            android:focusable="true"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_launcher_foreground" />
    </LinearLayout>

    <!-- เนื้อหาหลัก (เลื่อนได้) -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp">

            <!-- แท็บสลับหน้า (ตลาดสินค้า / บอร์ดตามหา) แบบโค้งมน -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginBottom="12dp"
                android:background="#E9ECEF"
                android:orientation="horizontal"
                android:padding="3dp">

                <TextView
                    android:id="@+id/tabMarketplace"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="#FFFFFF"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="🛒 ตลาดสินค้า (มีของ)"
                    android:textColor="#00794C"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:elevation="1dp" />

                <TextView
                    android:id="@+id/tabWantedBoard"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="📢 บอร์ดตามหาของ"
                    android:textColor="#6C757D"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- ช่องค้นหา -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginBottom="12dp"
                android:background="#FFFFFF"
                android:gravity="center_vertical"
                android:paddingHorizontal="14dp"
                android:elevation="1dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="8dp"
                    android:text="🔍"
                    android:textSize="14sp" />

                <EditText
                    android:id="@+id/etSearch"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@null"
                    android:hint="ค้นหา ชื่อสินค้า หรือสิ่งที่อยากได้..."
                    android:textColor="#212529"
                    android:textColorHint="#ADB5BD"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- แถบหมวดหมู่สินค้า (เลื่อนแนวนอนได้) -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/catAll"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginRight="8dp"
                        android:background="#00794C"
                        android:clickable="true"
                        android:focusable="true"
                        android:paddingHorizontal="14dp"
                        android:paddingVertical="7dp"
                        android:text="🔥 ทั้งหมด"
                        android:textColor="#FFFFFF"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/catBook"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginRight="8dp"
                        android:background="#FFFFFF"
                        android:clickable="true"
                        android:focusable="true"
                        android:paddingHorizontal="14dp"
                        android:paddingVertical="7dp"
                        android:text="📖 หนังสือเรียน"
                        android:textColor="#495057"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/catEquipment"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginRight="8dp"
                        android:background="#FFFFFF"
                        android:clickable="true"
                        android:focusable="true"
                        android:paddingHorizontal="14dp"
                        android:paddingVertical="7dp"
                        android:text="✏️ อุปกรณ์เรียน"
                        android:textColor="#495057"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/catIt"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="#FFFFFF"
                        android:clickable="true"
                        android:focusable="true"
                        android:paddingHorizontal="14dp"
                        android:paddingVertical="7dp"
                        android:text="💻 ไอที/หูฟัง"
                        android:textColor="#495057"
                        android:textSize="11sp" />
                </LinearLayout>
            </HorizontalScrollView>

            <!-- แถบประเภทประกาศ (ทุกประเภท / ขาย / แลก / ให้ฟรี) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/typeAll"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="6dp"
                    android:background="#212529"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="6dp"
                    android:text="ทุกประเภท"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/typeSell"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="6dp"
                    android:background="#D1E7DD"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="6dp"
                    android:text="🟢 ขาย"
                    android:textColor="#00794C"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/typeSwap"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="6dp"
                    android:background="#E2E3E5"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="6dp"
                    android:text="🔄 แลก"
                    android:textColor="#495057"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/typeFree"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="#F8D7DA"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="6dp"
                    android:text="🎁 ให้ฟรี"
                    android:textColor="#842029"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- แบนเนอร์ประชาสัมพันธ์ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                android:background="#00A86B"
                android:orientation="vertical"
                android:padding="16dp"
                android:elevation="1dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="#00794C"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="3dp"
                    android:text="พื้นที่ชาวราชภัฏพิบูลสงคราม"
                    android:textColor="#FFFFFF"
                    android:textSize="9.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="ของไม่ได้ใช้ ส่งต่อให้เพื่อนในมอ 🎓"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="ประหยัดเงินในกระเป๋า ลดขยะ ร่วมใจชาว PSRU"
                    android:textColor="#E2F0EC"
                    android:textSize="10.5sp" />
            </LinearLayout>

            <!-- หัวข้อรายการสินค้า -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvSectionTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="รายการสินค้า (ขาย / แลก / ให้ฟรี)"
                    android:textColor="#212529"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvViewAll"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:clickable="true"
                    android:focusable="true"
                    android:text="6 รายการ"
                    android:textColor="#6C757D"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- กล่องคอนเทนเนอร์สำหรับแสดงรายการสินค้า -->
            <LinearLayout
                android:id="@+id/containerProducts"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

        </LinearLayout>
    </ScrollView>

    <!-- เมนูด้านล่างสุด (Bottom Navigation) แบบ 3 ปุ่มที่จัดสัดส่วนเท่ากัน -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="#FFFFFF"
        android:elevation="8dp"
        android:orientation="horizontal">

        <!-- ปุ่มตลาดนัด -->
        <LinearLayout
            android:id="@+id/navMarket"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical"
            android:background="?attr/selectableItemBackground">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🏠"
                android:textSize="14sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ตลาดนัด"
                android:textColor="#00794C"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- ปุ่มรายการโปรด -->
        <LinearLayout
            android:id="@+id/navFavorite"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical"
            android:background="?attr/selectableItemBackground">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="❤️"
                android:textSize="14sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="รายการโปรด"
                android:textColor="#6C757D"
                android:textSize="10sp" />
        </LinearLayout>

        <!-- ปุ่มโปรไฟล์ -->
        <LinearLayout
            android:id="@+id/navProfile"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical"
            android:background="?attr/selectableItemBackground">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="👤"
                android:textSize="14sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="โปรไฟล์"
                android:textColor="#6C757D"
                android:textSize="10sp" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
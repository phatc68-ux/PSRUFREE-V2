<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="56dp"
    android:background="#FFFFFF"
    android:elevation="8dp"
    android:orientation="horizontal">

    <!-- เมนูตลาดนัด -->
    <LinearLayout
        android:id="@+id/navMarket"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical"
        android:clickable="true"
        android:focusable="true"
        android:background="?attr/selectableItemBackground">
        <ImageView
            android:id="@+id/ivNavMarket"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@android:drawable/ic_menu_agenda" />
        <TextView
            android:id="@+id/tvNavMarket"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ตลาดนัด"
            android:textColor="#666666"
            android:textSize="10sp" />
    </LinearLayout>

    <!-- เมนูรายการโปรด -->
    <LinearLayout
        android:id="@+id/navFavorite"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical"
        android:clickable="true"
        android:focusable="true"
        android:background="?attr/selectableItemBackground">
        <ImageView
            android:id="@+id/ivNavFavorite"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@android:drawable/ic_menu_myplaces" />
        <TextView
            android:id="@+id/tvNavFavorite"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="รายการโปรด"
            android:textColor="#666666"
            android:textSize="10sp" />
    </LinearLayout>

    <!-- เมนูโปรไฟล์ -->
    <LinearLayout
        android:id="@+id/navProfile"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical"
        android:clickable="true"
        android:focusable="true"
        android:background="?attr/selectableItemBackground">
        <ImageView
            android:id="@+id/ivNavProfile"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@android:drawable/ic_menu_manage" />
        <TextView
            android:id="@+id/tvNavProfile"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="โปรไฟล์"
            android:textColor="#666666"
            android:textSize="10sp" />
    </LinearLayout>

</LinearLayout>
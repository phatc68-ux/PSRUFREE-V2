<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_dialog_rounded"
    android:padding="0dp">

    <!-- ส่วนรูปภาพสินค้าด้านบน -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="220dp"
        android:background="#000000">

        <ImageView
            android:id="@+id/ivDetailProduct"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop" />

        <!-- ปุ่มปิด (กากบาท) -->
        <ImageView
            android:id="@+id/btnClose"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_gravity="top|end"
            android:layout_margin="12dp"
            android:background="@drawable/bg_circle_close"
            android:padding="8dp"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            android:tint="#FFFFFF" />

        <!-- ป้ายกำกับสถานะสินค้า (เช่น ขาย) -->
        <TextView
            android:id="@+id/tvDetailBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="12dp"
            android:background="#00794C"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:text="ขาย"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold" />
    </FrameLayout>

    <!-- ส่วนรายละเอียดด้านล่าง -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvDetailCategory"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="GADGET - PSRU SWAP"
                android:textColor="#00794C"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvDetailPrice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="7500 ฿"
                android:textColor="#00794C"
                android:textSize="18sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvDetailName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="ชื่อสินค้า..."
            android:textColor="#333333"
            android:textSize="16sp"
            android:textStyle="bold" />

        <!-- การ์ดข้อมูลผู้ขาย -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_rounded_card"
            android:orientation="vertical"
            android:padding="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/ivSellerProfile"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_circle_placeholder"
                    android:scaleType="centerCrop" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvSellerName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ชื่อผู้ขาย"
                        android:textColor="#333333"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvSellerSubInfo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="คณะวิทยาศาสตร์ฯ · PSRU"
                        android:textColor="#666666"
                        android:textSize="11sp" />
                </LinearLayout>

                <!-- เพิ่มปุ่มให้คะแนนผู้ขายตรงนี้ -->
                <Button
                    android:id="@+id/btnRateSeller"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:backgroundTint="#FFA500"
                    android:text="★ ให้คะแนน"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp" />

            </LinearLayout>

            <!-- ช่องทางการติดต่อผู้ขาย (Facebook, IG, Phone) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="#F8F9FA"
                android:orientation="vertical"
                android:padding="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ช่องทางการติดต่อผู้ขาย"
                    android:textColor="#00794C"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <!-- Facebook -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">
                    <TextView
                        android:id="@+id/tvContactFacebook"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Facebook: -"
                        android:textColor="#333333"
                        android:textSize="12sp" />
                    <Button
                        android:id="@+id/btnCopyFb"
                        android:layout_width="wrap_content"
                        android:layout_height="30dp"
                        android:text="คัดลอก"
                        android:textSize="10sp" />
                </LinearLayout>

                <!-- Instagram -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">
                    <TextView
                        android:id="@+id/tvContactInstagram"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Instagram: -"
                        android:textColor="#333333"
                        android:textSize="12sp" />
                    <Button
                        android:id="@+id/btnCopyIg"
                        android:layout_width="wrap_content"
                        android:layout_height="30dp"
                        android:text="คัดลอก"
                        android:textSize="10sp" />
                </LinearLayout>

                <!-- Phone -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">
                    <TextView
                        android:id="@+id/tvContactPhone"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="โทร: -"
                        android:textColor="#333333"
                        android:textSize="12sp" />
                    <Button
                        android:id="@+id/btnCopyPhone"
                        android:layout_width="wrap_content"
                        android:layout_height="30dp"
                        android:text="โทร / คัดลอก"
                        android:textSize="10sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- รายละเอียด -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="รายละเอียด"
            android:textColor="#333333"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvDetailDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="รายละเอียดเพิ่มเติม..."
            android:textColor="#666666"
            android:textSize="12sp" />

        <!-- สถานที่นัดรับ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="#E8F5E9"
            android:padding="10dp"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="จุดนัดรับและเป้าภายใน ม.พิบูลสงคราม:"
                android:textColor="#00794C"
                android:textSize="11sp"
                android:textStyle="bold"/>
            <TextView
                android:id="@+id/tvDetailLocation"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="อาคารเรียนรวมและหอประชุม (กป.) หรือโรงอาหารกลาง"
                android:textColor="#333333"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- ปุ่มบันทึกรายการโปรด -->
        <Button
            android:id="@+id/ivFavorite"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:backgroundTint="#F1F3F5"
            android:text="❤️ บันทึกในรายการโปรดแล้ว"
            android:textColor="#333333" />

    </LinearLayout>
</LinearLayout>